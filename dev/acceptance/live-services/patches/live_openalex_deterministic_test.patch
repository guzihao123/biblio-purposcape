+def _inject_retracted_filter(url):
+    """Append is_retracted:true to the OpenAlex filter parameter only.
+
+    Test-side URL transform: the query string stays identical to
+    RETRACTED_QUERY and no production retrieval code is touched.
+    """
+    parsed = urllib.parse.urlsplit(url)
+    pairs = urllib.parse.parse_qsl(parsed.query)
+    rebuilt = [
+        (key, value + RETRACTED_FILTER_FRAGMENT
+         if key == 'filter' and 'is_retracted:true' not in value else value)
+        for key, value in pairs
+    ]
+    return urllib.parse.urlunsplit(
+        parsed._replace(query=urllib.parse.urlencode(rebuilt))
+    )
+
