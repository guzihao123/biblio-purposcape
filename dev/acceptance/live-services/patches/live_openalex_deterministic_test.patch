+def test_retraction_commentary_type_policy_offline():
+    """Faculty Opinions commentary: peer-review type policy, not retraction.
+
+    Recorded real metadata from the 2026-11-24 live run (the relevance top hit
+    that exposed the wrong ordering assumption in the original live test).
+    Offline test: no network, no fixtures acting as provider responses — the
+    literals are bibliographic facts observed from the real API. The assertion
+    locks in that title association with a retracted paper never marks this
+    commentary retracted, and that its exclusion from paper pools is the
+    peer-review type policy only.
+    """
+    from app.search import _normalize_record
+
+    commentary = {
+        'source': 'openalex',
+        'id': 'https://openalex.org/W4213234079',
+        'title': (
+            'Faculty Opinions recommendation of Hydroxychloroquine or '
+            'chloroquine with or without a macrolide for treatment of '
+            'COVID-19: a multinational registry analysis.'
+        ),
+        'year': 2020,
+        'authors': ['Faculty Opinions'],
+        'venue': 'Faculty Opinions',
+        'cited_by_count': 0,
+        'doi': 'https://doi.org/10.3410/f.737996380.793574823',
+        'url': 'https://doi.org/10.3410/f.737996380.793574823',
+        'oa_url': None,
+        'pdf_url': None,
+        'abstract': 'Commentary on the retracted registry analysis.',
+        'type': 'peer-review',
+        'is_retracted': False,
+        'referenced_works': [],
+    }
+
+    normalized = _normalize_record(commentary)
+    assert normalized['is_retracted'] is False
+
+    pool = merge_records([commentary], limit=5, from_year=None, mode='A')
+    assert pool['count'] == 0
+    assert commentary['id'] not in {paper['id'] for paper in pool['papers']}
